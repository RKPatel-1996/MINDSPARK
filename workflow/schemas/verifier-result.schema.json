{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindspark.local/workflow/verifier-result.schema.json",
  "title": "MindSpark verifier result",
  "description": "Independent verification judgment linked to an immutable task contract.",
  "$comment": "The verifier may escalate risk and evidence, but this result cannot expand acceptance criteria, allowed files, or product scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "contract_hash",
    "base",
    "feature_head",
    "decision",
    "reject_class",
    "effective_risk",
    "contract_violations",
    "diff_issues",
    "compatibility_findings",
    "tests_run",
    "missing_evidence",
    "remaining_risks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"
    },
    "contract_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit"],
      "properties": {
        "branch": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "feature_head": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "decision": { "enum": ["ACCEPT", "REJECT"] },
    "reject_class": { "enum": ["A", "B", "C", null] },
    "effective_risk": { "enum": ["low", "normal", "high"] },
    "contract_violations": { "$ref": "#/$defs/strings" },
    "diff_issues": { "$ref": "#/$defs/strings" },
    "compatibility_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "status", "evidence"],
        "properties": {
          "area": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "NOT_APPLICABLE", "MISSING"] },
          "evidence": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "tests_run": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "result": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] }
        }
      }
    },
    "missing_evidence": { "$ref": "#/$defs/strings" },
    "remaining_risks": { "$ref": "#/$defs/strings" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "ACCEPT" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "reject_class": { "type": "null" },
          "contract_violations": { "type": "array", "maxItems": 0 },
          "diff_issues": { "type": "array", "maxItems": 0 },
          "compatibility_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": { "enum": ["PASS", "NOT_APPLICABLE"] }
              }
            }
          },
          "tests_run": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "result": { "const": "PASS" }
              }
            }
          },
          "missing_evidence": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "REJECT" } }, "required": ["decision"] },
      "then": { "properties": { "reject_class": { "enum": ["A", "B", "C"] } } }
    }
  ],
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}