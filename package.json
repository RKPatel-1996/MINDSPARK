{
  "name": "mindspark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:firestore-rules": "node scripts/prepare-firestore-rules.mjs",
    "verify:firestore-rules": "node scripts/verify-firestore-rules.mjs",
    "prepare:storage-rules": "node scripts/prepare-storage-rules.mjs",
    "verify:storage-rules": "node scripts/verify-storage-rules.mjs",
    "preflight:production": "node scripts/preflight-production.mjs",
    "prepare:test-firestore-rules": "node scripts/prepare-test-firestore-rules.mjs",
    "prepare:test-storage-rules": "node scripts/prepare-test-storage-rules.mjs",
    "test:storage-rules": "npm run prepare:test-storage-rules && firebase --config firebase-test.json emulators:exec --only storage \"vitest run src/v2/persistence/firebase/__tests__/storage.rules.test.ts\"",
    "test:rules": "npm run prepare:test-firestore-rules && npm run prepare:test-storage-rules && firebase --config firebase-test.json emulators:exec --only firestore,storage \"vitest run --no-file-parallelism --maxWorkers=1 src/v2/persistence/firebase/__tests__\"",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run verify:web-release",
    "deploy": "gh-pages -d dist -r https://github.com/RKPatel-1996/MINDSPARK.git",
    "build:android": "npm run build && npx cap sync android",
    "open:android": "npx cap open android",
    "test": "vitest run --exclude=\"src/v2/persistence/firebase/__tests__/*.test.ts\" --exclude=\"src/v2/__tests__/pwaBuildArtifacts.test.ts\"",
    "test:pwa-build": "node scripts/test-pwa-build.mjs",
    "verify:web-release": "npm run typecheck && npm test && npm run test:pwa-build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "validate:workflow": "node workflow/scripts/validate.mjs",
    "workflow:merge": "node workflow/scripts/merge-verified.mjs",
    "test:workflow-merge": "node --test workflow/tests/verified-merge.node-test.mjs",
    "verify:workflow": "npm run validate:workflow && npm run test:workflow-merge",
    "preflight:firebase-core": "node scripts/preflight-firebase-core.mjs",
    "test:firestore-rules": "npm run prepare:test-firestore-rules && firebase --config firebase-test.json emulators:exec --only firestore \"vitest run src/v2/persistence/firebase/__tests__/firestore.rules.test.ts\""
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "firebase": "12.19.0",
    "katex": "0.16.47",
    "lucide-react": "^0.564.0",
    "motion": "^13.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "ts-fsrs": "5.4.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@firebase/rules-unit-testing": "5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "8.20.0",
    "firebase-tools": "15.31.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^5.0.0",
    "yaml": "2.9.1"
  }
}
